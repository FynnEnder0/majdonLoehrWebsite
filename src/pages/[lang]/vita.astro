---
import Base from '../../layouts/Base.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CurtainRule from '../../components/ui/CurtainRule.astro';
import PhotoCollage from '../../components/ui/PhotoCollage.astro';
import MotionReveal from '../../components/ui/MotionReveal.tsx';
import ActivityIcon from '../../components/ui/ActivityIcon.astro';
import { castingFacts, skillGroups } from '../../data/profile';
import { credits } from '../../data/credits';
import { ui, type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { site } from '../../data/site';

// Porträt für Casting-Sheet (Print)
import printPortrait from '../../assets/gallery/shootings/shootingwarmlicht.jpg';

// Scrapbook-Collage: Mix aus Porträts & Privatem fürs „Mensch hinter der Rolle"-Gefühl
import c1 from '../../assets/gallery/shootings/shootingwarmlicht2.jpg';
import c2 from '../../assets/gallery/shootings/shootingwarmlicht.jpg';
import c3 from '../../assets/gallery/shootings/portrait4-laecheln.jpg';
import c4 from '../../assets/gallery/shootings/shootingschwarzweiss.jpg';
import c5 from '../../assets/gallery/shootings/shootinglichtoben.jpg';
import c6 from '../../assets/gallery/privat/baumnah.jpg';

export function getStaticPaths() {
  return (Object.keys(ui) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const collage = [c1, c2, c3, c4, c5, c6].map((src) => ({ src, alt: t.meta.ogAlt }));
---

<Base lang={lang} title={t.vita.metaTitle} description={t.vita.metaDescription}>
  <!-- Kopf + Scrapbook -->
  <Section id="vita-intro" class="bg-stage-dark" aria-labelledby="vita-heading">
    <MotionReveal client:visible>
      <Eyebrow text={t.vita.eyebrow} />
      <div id="vita-heading">
        <SectionHeading as="h1" text={t.vita.heading} class="mt-5" />
      </div>
      <p class="mt-6 max-w-prose-col font-body text-2xl italic leading-relaxed text-warm-ash">
        {t.vita.lead}
      </p>
      <div class="vita-export-wrap mt-8">
        <button
          id="vita-export-btn"
          class="inline-flex items-center gap-2 font-mono text-sm font-bold uppercase tracking-[0.14em] transition-colors duration-200 min-h-[44px] px-6 bg-footlight text-stage-dark hover:bg-parchment focus-visible:bg-parchment"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          {t.vita.exportPdf}
        </button>
      </div>
    </MotionReveal>

    <MotionReveal client:visible delay={0.1}>
      <PhotoCollage images={collage} class="mt-14" />
    </MotionReveal>
  </Section>

  <!-- Print-only: Casting-Sheet-Header (auf dem Screen unsichtbar) -->
  <div class="print-only hidden" aria-hidden="true">
    <div class="print-header">
      <div class="print-header-text">
        <div class="print-name">{site.name}</div>
        <div class="print-role">{lang === 'de' ? site.jobTitle.de : site.jobTitle.en} · {lang === 'de' ? 'Sprecherin' : 'Voice Artist'}</div>
        <div class="print-contact">
          {new URL(site.url).hostname}<br />
          {site.email}
        </div>
      </div>
      <img
        src={printPortrait.src}
        width={printPortrait.width}
        height={printPortrait.height}
        alt={site.name}
        class="print-portrait"
      />
    </div>
  </div>

  <!-- Narrative Bio + Steckbrief + Fähigkeiten -->
  <Section class="bg-wing-shadow/20">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-20">
      <MotionReveal client:visible>
        <div class="max-w-prose-col">
          {/* Bildschirm: ausführlicher Über-mich-Text */}
          <div class="vita-screen-bio space-y-6">
            {
              t.about.body.map((para) => (
                <p class="font-body text-2xl leading-relaxed text-warm-ash">{para}</p>
              ))
            }
          </div>
          {/* Casting-Sheet (Print): kompakter Vita-Text */}
          <div class="print-only hidden space-y-4">
            {
              t.vita.castingBio.map((para) => (
                <p class="font-body text-2xl leading-relaxed text-warm-ash">{para}</p>
              ))
            }
          </div>
        </div>
      </MotionReveal>

      <MotionReveal client:visible delay={0.1}>
        <aside class="space-y-10">
          <div class="flex items-stretch gap-4">
            <CurtainRule class="min-h-full" />
            <div class="w-full">
              <h2 class="font-mono text-sm font-bold uppercase tracking-[0.2em] text-dusk-label">
                {t.vita.profileHeading}
              </h2>
              <dl class="mt-4 space-y-2.5">
                {
                  castingFacts.map((f) => (
                    <div class="flex justify-between gap-4 border-b border-wing-shadow pb-2.5">
                      <dt class="font-mono text-sm uppercase tracking-[0.08em] text-dusk-label">
                        {f.label[lang]}
                      </dt>
                      <dd class="text-right text-lg font-medium text-warm-ash">{f.value[lang]}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>

          <div class="flex items-stretch gap-4">
            <CurtainRule class="min-h-full" />
            <div>
              <h2 class="font-mono text-sm font-bold uppercase tracking-[0.2em] text-dusk-label">
                {t.vita.skillsHeading}
              </h2>
              <div class="mt-4 space-y-5">
                {
                  skillGroups.map((group) => (
                    <div>
                      <p class="font-body text-xl font-semibold text-parchment">{group.title[lang]}</p>
                      <ul class="mt-1 flex flex-wrap gap-x-3 gap-y-1">
                        {group.items.map((item, i) => (
                          <li class="font-body text-lg text-warm-ash">
                            {item[lang]}
                            {i < group.items.length - 1 && (
                              <span class="ml-3 text-footlight/60">·</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </aside>
      </MotionReveal>
    </div>
  </Section>

  <!-- Engagements (Anker-Ziel von „Alle Engagements") -->
  <Section id="engagements" class="bg-stage-dark" aria-labelledby="engagements-heading">
    <MotionReveal client:visible>
      <div id="engagements-heading">
        <SectionHeading text={t.vita.creditsHeading} />
      </div>
    </MotionReveal>

    <ul class="mt-12 divide-y divide-wing-shadow border-t border-wing-shadow">
      {
        credits.map((c, i) => (
          <li>
            <MotionReveal client:visible delay={Math.min(i * 0.08, 0.4)}>
              <article class="group grid grid-cols-1 gap-2 py-6 sm:grid-cols-[5rem_1fr_auto] sm:items-center sm:gap-6">
                <span class="font-mono text-base font-bold tracking-[0.12em] text-footlight">
                  {c.year}
                  {c.upcoming && (
                    <span class="block font-mono text-xs font-normal not-italic normal-case tracking-wide text-dusk-label/60 mt-0.5">
                      {t.work.upcoming}
                    </span>
                  )}
                </span>
                <div class="flex items-start gap-3">
                  <ActivityIcon
                    type={c.category}
                    class="mt-0.5 h-[3.75rem] w-[3.75rem] shrink-0 text-footlight md:h-[4.25rem] md:w-[4.25rem]"
                  />
                  <div>
                    <h3 class="font-display text-2xl text-parchment md:text-3xl">
                      {c.production[lang]}
                    </h3>
                    <p class="mt-1 font-body text-xl italic text-warm-ash">
                      {t.work.columns.role}: {c.role[lang]}
                    </p>
                  </div>
                </div>
                <span class="font-mono text-sm uppercase tracking-[0.1em] text-dusk-label sm:text-right">
                  {c.venue[lang]}
                </span>
              </article>
            </MotionReveal>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 font-mono text-xs uppercase tracking-[0.16em] text-warm-ash/50">
      {t.work.placeholderNote}
    </p>

    <div class="mt-16">
      <a
        href={`/${lang}`}
        class="vita-back-link font-mono text-sm uppercase tracking-[0.16em] text-footlight transition-colors hover:text-parchment"
      >
        ← {t.common.backHome}
      </a>
    </div>
  </Section>

  <script>
    document.getElementById('vita-export-btn')?.addEventListener('click', () => window.print());
  </script>
</Base>
