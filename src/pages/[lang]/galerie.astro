---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import GalleryClient from '../../components/sections/GalleryClient.tsx';
import { gallery } from '../../data/gallery';
import { site } from '../../data/site';
import { ui, type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return (Object.keys(ui) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

// Build-Zeit-Optimierung: Thumb (Grid) + Full (Lightbox) je Bild.
const items = await Promise.all(
  gallery.map(async (g) => {
    const thumb = await getImage({ src: g.src, width: 800, format: 'webp', quality: 72 });
    const full = await getImage({ src: g.src, width: 1600, format: 'webp', quality: 80 });
    const width = Number(thumb.attributes.width ?? g.src.width);
    const height = Number(thumb.attributes.height ?? g.src.height);
    return {
      thumb: thumb.src,
      full: full.src,
      width,
      height,
      alt: g.alt[lang],
      category: g.category,
    };
  }),
);
---

<Base lang={lang} title={t.galleryPage.metaTitle} description={t.galleryPage.metaDescription}>
  <Section class="bg-stage-dark" aria-labelledby="gallery-heading">
    <Eyebrow text={t.gallery.eyebrow} />
    <div id="gallery-heading">
      <SectionHeading as="h1" text={t.gallery.heading} class="mt-5" />
    </div>

    <GalleryClient
      client:visible
      items={items}
      labels={{
        all: t.gallery.filterAll,
        shootings: t.gallery.filterShootings,
        rollen: t.gallery.filterRollen,
        privat: t.gallery.filterPrivat,
        close: t.gallery.close,
        prev: t.gallery.prev,
        next: t.gallery.next,
      }}
    />

    {site.reelUrl && (
      <div class="mt-16">
        <h2 class="font-mono text-sm font-bold uppercase tracking-[0.2em] text-dusk-label">
          {t.gallery.reelHeading}
        </h2>
        <div class="mt-4 aspect-video w-full overflow-hidden">
          <iframe
            src={site.reelUrl}
            class="h-full w-full"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
          />
        </div>
      </div>
    )}

    <div class="mt-16">
      <a
        href={`/${lang}`}
        class="font-mono text-sm uppercase tracking-[0.16em] text-footlight transition-colors hover:text-parchment"
      >
        ← {t.common.backHome}
      </a>
    </div>
  </Section>
</Base>
