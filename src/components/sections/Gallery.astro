---
import { getImage } from 'astro:assets';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import MotionReveal from '../ui/MotionReveal.tsx';
import warmlicht from '../../assets/gallery/shootings/shootingwarmlicht.jpg';
import schwarzweiss from '../../assets/gallery/shootings/shootingschwarzweiss.jpg';
import lichtoben from '../../assets/gallery/shootings/shootinglichtoben.jpg';
import portrait from '../../assets/gallery/shootings/portrait.jpg';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Teaser: kuratierter Vorschau-Streifen — vier verschiedene Shootings
// (warmes Licht, Schwarz-Weiß, Licht von oben, Studio) statt der ersten vier.
const shootAlt =
  lang === 'de' ? 'Porträtaufnahme von Majdon Löhr' : 'Portrait photograph of Majdon Löhr';
const previews = await Promise.all(
  [warmlicht, schwarzweiss, lichtoben, portrait].map(async (src) => {
    const img = await getImage({ src, width: 500, format: 'webp', quality: 72 });
    return { src: img.src, alt: shootAlt };
  }),
);
---

<Section id="gallery" class="bg-wing-shadow/30" aria-labelledby="gallery-heading">
  <MotionReveal client:visible>
    <Eyebrow act="III" text={t.gallery.eyebrow} />
    <div id="gallery-heading">
      <SectionHeading text={t.gallery.heading} class="mt-5" />
    </div>
    <p class="mt-6 max-w-prose-col font-body text-2xl leading-relaxed text-warm-ash">
      {t.gallery.teaser}
    </p>
  </MotionReveal>

  <MotionReveal client:visible delay={0.1}>
    <a
      href={`/${lang}/galerie`}
      class="group mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4"
      aria-label={t.gallery.cta}
    >
      {
        previews.map((p) => (
          <img
            src={p.src}
            alt={p.alt}
            loading="lazy"
            class="aspect-[3/4] w-full border border-wing-shadow object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />
        ))
      }
    </a>

    <div class="mt-8">
      <Button href={`/${lang}/galerie`} variant="secondary">{t.gallery.cta} →</Button>
    </div>
  </MotionReveal>
</Section>
