---
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import MotionReveal from '../ui/MotionReveal.tsx';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="about" class="bg-stage-dark" aria-labelledby="about-heading">
  <MotionReveal client:visible>
    <div class="max-w-prose-col">
      <Eyebrow act="I" text={t.about.eyebrow} />
      <div id="about-heading">
        <SectionHeading text={t.about.heading} class="mt-5" />
      </div>
      <p class="mt-6 font-body text-2xl leading-relaxed text-warm-ash md:text-3xl">
        {t.about.teaser}
      </p>
      <div class="mt-9">
        <Button href={`/${lang}/vita`} variant="secondary">{t.about.cta} →</Button>
      </div>
    </div>
  </MotionReveal>
</Section>
