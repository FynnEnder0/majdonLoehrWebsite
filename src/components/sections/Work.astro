---
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CurtainRule from '../ui/CurtainRule.astro';
import Button from '../ui/Button.astro';
import MotionReveal from '../ui/MotionReveal.tsx';
import { credits } from '../../data/credits';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Teaser: nur die ersten (wichtigsten) Engagements — die volle Liste lebt auf /vita
const featured = credits.slice(0, 3);
---

<Section id="work" class="bg-wing-shadow/30" aria-labelledby="work-heading">
  <MotionReveal client:visible>
    <Eyebrow act="II" text={t.work.eyebrow} />
    <div id="work-heading">
      <SectionHeading text={t.work.heading} class="mt-5" />
    </div>
    <p class="mt-6 max-w-prose-col font-body text-2xl leading-relaxed text-warm-ash">
      {t.work.intro}
    </p>
  </MotionReveal>

  <ul class="mt-12 divide-y divide-wing-shadow border-t border-wing-shadow">
    {
      featured.map((c, i) => (
        <li>
          <MotionReveal client:visible delay={Math.min(i * 0.08, 0.3)}>
            <article class="group grid grid-cols-1 gap-2 py-6 sm:grid-cols-[5rem_1fr_auto] sm:items-center sm:gap-6">
              <span class="font-mono text-base font-bold tracking-[0.12em] text-footlight">
                {c.year}
                {c.upcoming && (
                  <span class="block font-mono text-xs font-normal not-italic normal-case tracking-wide text-dusk-label/60 mt-0.5">
                    {t.work.upcoming}
                  </span>
                )}
              </span>
              <div class="flex items-stretch gap-3">
                <div>
                  <h3 class="font-display text-2xl text-parchment md:text-3xl">
                    {c.production[lang]}
                  </h3>
                  <p class="mt-1 font-body text-xl italic text-warm-ash">
                    {t.work.columns.role}: {c.role[lang]}
                  </p>
                </div>
              </div>
              <span class="font-mono text-sm uppercase tracking-[0.1em] text-dusk-label sm:text-right">
                {c.venue[lang]}
              </span>
            </article>
          </MotionReveal>
        </li>
      ))
    }
  </ul>

  <div class="mt-10">
    <Button href={`/${lang}/vita#engagements`} variant="secondary">
      {t.work.cta} →
    </Button>
  </div>
</Section>
