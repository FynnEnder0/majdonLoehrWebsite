---
type Props = {
  type: 'theater' | 'film' | 'voice';
  class?: string;
};
const { type, class: className = '' } = Astro.props;
---

{type === 'theater' && (
  <svg viewBox="0 0 120 120" class={className} fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M70,40 C58,40 51,50 51,64 C51,79 60,90 70,90 C80,90 89,79 89,64 C89,50 82,40 70,40 Z" stroke-width="2.4"/>
    <path d="M59,62 q5,4 11,1" stroke-width="1.7"/>
    <path d="M72,63 q5,4 11,-1" stroke-width="1.7"/>
    <path d="M61,78 q9,-7 18,0" stroke-width="1.9"/>
    <path d="M50,36 C38,36 31,46 31,60 C31,75 40,86 50,86 C60,86 69,75 69,60 C69,46 62,36 50,36 Z" stroke-width="2.4"/>
    <path d="M39,59 q5,-5 11,0" stroke-width="1.7"/>
    <path d="M52,59 q5,-5 11,0" stroke-width="1.7"/>
    <path d="M41,68 q9,9 18,0" stroke-width="1.9"/>
  </svg>
)}

{type === 'film' && (
  <svg viewBox="0 0 120 120" class={className} fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="30" y="40" width="60" height="14" stroke-width="2.4"/>
    <rect x="30" y="54" width="60" height="26" stroke-width="2.4"/>
    <path d="M30,54 L40,54 L46,40 L36,40 Z" fill="currentColor" stroke="none"/>
    <path d="M50,54 L60,54 L66,40 L56,40 Z" fill="currentColor" stroke="none"/>
    <path d="M70,54 L80,54 L86,40 L76,40 Z" fill="currentColor" stroke="none"/>
    <path d="M38,64 H82" stroke-width="1.7" opacity="0.55"/>
    <path d="M38,72 H70" stroke-width="1.7" opacity="0.55"/>
  </svg>
)}

{type === 'voice' && (
  <svg viewBox="0 0 120 120" class={className} fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M76,42 q9,13 0,26" stroke-width="1.9"/>
    <path d="M84,36 q15,19 0,38" stroke-width="1.6"/>
    <path d="M44,42 q-9,13 0,26" stroke-width="1.9"/>
    <path d="M36,36 q-15,19 0,38" stroke-width="1.6"/>
    <path d="M60,30 C53,30 48,36 48,45 V62 C48,69 53,73 60,73 C67,73 72,69 72,62 V45 C72,36 67,30 60,30 Z" stroke-width="2.4"/>
    <path d="M48,62 H72" stroke-width="1.9"/>
    <path d="M54,73 H66 L65,82 H55 Z" stroke-width="2.1"/>
    <path d="M60,82 V90" stroke-width="2.4"/>
  </svg>
)}
